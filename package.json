{
  "name": "vitanexus-rx-ddi-major-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/startDevelopment.js",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "postinstall": "prisma generate",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api:start": "node server/index.js",
    "api:test": "vitest run --config server/vitest.config.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "data:process": "node scripts/processKnowledgeDatasets.js && node scripts/processDrugcentralKnowledge.js",
    "data:process:core": "node scripts/processKnowledgeDatasets.js",
    "data:process:drugcentral": "node scripts/processDrugcentralKnowledge.js",
    "data:import": "node scripts/importClinicalKnowledge.js",
    "ml:preprocess": "node scripts/runMl.js preprocess",
    "ml:train:lightgbm": "node scripts/runMl.js train-lightgbm",
    "ml:train:hgnn": "node scripts/runMl.js train-hgnn",
    "ml:evaluate": "node scripts/runMl.js evaluate",
    "ml:serve": "node scripts/runMl.js serve",
    "ml:test": "ml\\.venv\\Scripts\\python.exe -m pytest ml/tests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^12.42.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.26.0",
    "morgan": "^1.11.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.22",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
