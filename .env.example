# Copy to .env and replace values before deploying.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://vitanexus:vitanexus_dev_password@localhost:5432/vitanexus?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-32-character-minimum-secret"
JWT_ACCESS_EXPIRES_IN="15m"
CORS_ORIGIN="http://localhost:5173"
# On Vercel, set DATABASE_URL to a hosted PostgreSQL database and
# JWT_ACCESS_SECRET to a production-only secret. Do not set VITE_API_BASE_URL;
# the deployed frontend uses its same-origin /api/v1 serverless route.
