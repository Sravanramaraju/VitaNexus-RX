# Copy to .env and replace values before deploying.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://vitanexus:vitanexus_dev_password@localhost:5432/vitanexus?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-32-character-minimum-secret"
JWT_ACCESS_EXPIRES_IN="15m"
CORS_ORIGIN="http://localhost:5173"
VITE_API_BASE_URL="/api/v1"
ADR_ML_BASE_URL="http://127.0.0.1:8000"
ADR_ML_TIMEOUT_MS="30000"
DATABASE_TRANSACTION_TIMEOUT_MS="15000"
# On Vercel, set DATABASE_URL to a hosted PostgreSQL database and
# JWT_ACCESS_SECRET to a production-only secret. The relative API URL works
# with both Vite's development proxy and the deployed /api/v1 route.
